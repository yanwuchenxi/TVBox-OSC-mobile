<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    tools:context=".ui.activity.SettingActivity">

    <com.hjq.bar.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="设置"
        app:titleColor="#FFFFFF"
        app:lineVisible="false"
        app:titleSize="18sp"
        android:background="#0B1220"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="28dp">

            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="配置"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_card"
                android:paddingVertical="4dp">
                
                <LinearLayout
                    android:id="@+id/llConfigApi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="配置地址"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvConfigApi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="订阅管理"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLiveApi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="直播地址"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvLiveApi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llHomeRec"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="首页推荐"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvHomeRec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="豆瓣热播"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

            </LinearLayout>


            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="设置"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_card"
                android:paddingVertical="4dp">
                
                <LinearLayout
                    android:id="@+id/showFastSearch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搜索展示"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/showFastSearchText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="文字列表"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llHistoryNum"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="历史记录"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvHistoryNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPrivateBrowsing"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="全局无痕"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPrivateBrowsing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llVideoPurify"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="去广告"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVideoPurify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTheme"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="主题"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跟随系统"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

            </LinearLayout>


            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="播放器"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_card"
                android:paddingVertical="4dp">
                
                <LinearLayout
                    android:id="@+id/llPlay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="播放器"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXO"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMediaCodec"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="解码方式"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvMediaCodec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="硬解码"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRender"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="渲染方式"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvRenderType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextureView"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llScale"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="画面缩放"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvScaleType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPressSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="长按倍速"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.0"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llBackgroundPlay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="后台播放"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvBackgroundPlayType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关闭"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llIjkCachePlay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IJK缓存"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchIjkCachePlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

            </LinearLayout>


            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="系统"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_setting_card"
                android:paddingVertical="4dp">
                
                <LinearLayout
                    android:id="@+id/llDns"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="安全DNS"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvDns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关闭"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llBackup"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="数据备份"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_setting_row"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="清空缓存"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"/>
                    
                    <TextView
                        android:id="@+id/tvCacheSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0MB"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="180dp"/>
                    
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/icon_pre"
                        android:alpha="0.55"
                        app:tint="#99FFFFFF"/>
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
