<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="8dp"
    android:paddingBottom="12dp">

    <CheckBox
        android:id="@+id/cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:clickable="false"
        android:focusable="false" />

    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:padding="8dp"
        android:src="@drawable/dkplayer_ic_action_close"
        app:tint="@color/red" />

    <ImageView
        android:id="@+id/iv_pushpin"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@id/iv_del"
        android:layout_toStartOf="@id/iv_del"
        android:padding="4dp"
        android:src="@drawable/ic_pushpin"
        android:visibility="gone"
        app:tint="@color/colorPrimary"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/iv_pushpin"
        android:layout_toStartOf="@id/iv_pushpin"
        android:layout_toRightOf="@id/cb"
        android:layout_toEndOf="@id/cb"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_foreground"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="我的订阅" />

    <TextView
        android:id="@+id/tv_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_name"
        android:layout_marginTop="4dp"
        android:layout_toLeftOf="@id/iv_pushpin"
        android:layout_toStartOf="@id/iv_pushpin"
        android:layout_toRightOf="@id/cb"
        android:layout_toEndOf="@id/cb"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"
        tools:text="https://example.com/config.json" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_url"
        android:layout_marginTop="4dp"
        android:layout_toRightOf="@id/cb"
        android:layout_toEndOf="@id/cb"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="有效"
        tools:visibility="visible" />
</RelativeLayout>
